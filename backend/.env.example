# Backend env example (NO subir .env real a GitHub)
PORT=5000

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=hospital_db
DB_POOL_LIMIT=10

# Auth
JWT_SECRET=change-me

# Bootstrap admin (se crea al arrancar si no existe)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@clinica.com
DEFAULT_ADMIN_PASSWORD=123456

# Backups
# BACKUP_DIR=./tmp/backups
# BACKUP_PERSIST=0
